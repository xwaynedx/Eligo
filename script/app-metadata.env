# Shared metadata for the Eligo build scripts.
#
# Sourced by script/build_and_run.sh and script/release.sh so the bundle
# identifier, copyright, and version defaults live in exactly one place.
# ROOT_DIR must be set before sourcing. Every value can still be overridden
# from the environment; VERSION falls back to the repo-root VERSION file.
# LSMinimumSystemVersion lives only in the canonical Resources/Info.plist.

APP_NAME="Eligo"
BUNDLE_ID="${BUNDLE_ID:-io.github.xwaynedx.eligo}"
VERSION="${VERSION:-$(tr -d '[:space:]' < "$ROOT_DIR/VERSION")}"
BUILD_NUMBER="${BUILD_NUMBER:-1}"
COPYRIGHT="${COPYRIGHT:-Copyright © 2026 Wayne. Licensed under the Sustainable Use License, Version 1.0.}"
